# Python
__pycache__/
*.pyc

# Local runtime content (created next to solotone.py on first launch, or
# accumulated from actually using the app — not app source)
/nam/
/irs/
/profiles/
/pedal_presets/

# Dev-only experiments, never part of the shipped app (see memory:
# backlog-12string-emulation — failed prototype, kept around for
# reference, not meant to ship)
/prototypes/

# Claude Code's own session-runtime state, not project source
.claude/*.lock

# Packaging output — build/dist/*.exe is a release artifact, not source;
# keep the build scripts and icon, but not the generated binaries.
/build/dist/
/build/work/
/build/spec/

# Optional Tank-G add-on: only the files listed here are part of the repo. Everything else in the folder stays local
# (notes, measurements, captures, calibration, pedal backups, development scripts).
/tankg-bridge/*
!/tankg-bridge/README.md
!/tankg-bridge/LICENSE-PulseDeck-MIT.txt
!/tankg-bridge/a2l1.py
!/tankg-bridge/bridge.py
!/tankg-bridge/live.py
!/tankg-bridge/tankg_api.py
!/tankg-bridge/backup_pedal.py
!/tankg-bridge/ultrarig_probe.py
!/tankg-bridge/test_tankg_api.py
!/tankg-bridge/test_backup.py

# Crash and error logs written by the app (see _install_crash_logging in solotone.py)
solotone_error.log
solotone_crash.log
